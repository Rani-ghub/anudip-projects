<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.college.sms.controller.MainController">

    <center>
        <TabPane>
            <!-- Students Tab -->
            <Tab text="Students">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="10">
                        <TextField fx:id="studentNameField" promptText="Name"/>
                        <TextField fx:id="studentEmailField" promptText="Email"/>
                        <Button text="Add Student" onAction="#handleAddStudent"/>
                    </HBox>
                    <TableView fx:id="studentTable" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="studentIdCol" text="ID"/>
                            <TableColumn fx:id="studentNameCol" text="Name"/>
                            <TableColumn fx:id="studentEmailCol" text="Email"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Courses Tab -->
            <Tab text="Courses">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="10">
                        <TextField fx:id="courseNameField" promptText="Course Name"/>
                        <TextField fx:id="courseDescField" promptText="Description"/>
                        <TextField fx:id="courseCreditsField" promptText="Credits"/>
                        <Button text="Add Course" onAction="#handleAddCourse"/>
                    </HBox>
                    <TableView fx:id="courseTable" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="courseIdCol" text="ID"/>
                            <TableColumn fx:id="courseNameCol" text="Name"/>
                            <TableColumn fx:id="courseDescCol" text="Description"/>
                            <TableColumn fx:id="courseCreditsCol" text="Credits"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Enrollments Tab -->
            <Tab text="Enrollments">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="10">
                        <ComboBox fx:id="studentCombo" promptText="Select Student"/>
                        <ComboBox fx:id="courseCombo" promptText="Select Course"/>
                        <Button text="Enroll" onAction="#handleEnroll"/>
                    </HBox>
                    <TableView fx:id="enrollmentTable" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="enrollIdCol" text="ID"/>
                            <TableColumn fx:id="enrollStudentCol" text="Student"/>
                            <TableColumn fx:id="enrollCourseCol" text="Course"/>
                            <TableColumn fx:id="enrollDateCol" text="Date"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
